<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:colorAccent">#0078FF</item>
        <item name="android:colorControlActivated">#BD00FF</item>
        <item name="android:colorControlHighlight">#55E3FF00</item>
        <item name="android:textColorPrimary">#1B1B24</item>
        <item name="android:textColorSecondary">#51515E</item>
        <item name="android:colorBackground">#D4D4D8</item>
        <item name="android:windowBackground">#D4D4D8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#D4D4D8</item>
        <item name="android:navigationBarColor">#D4D4D8</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:buttonStyle">@style/TrailButton</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="TrailButton" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#1B1B24</item>
        <item name="android:backgroundTint">#E7E7EB</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>
