<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@string/ui_body_font</item>
        <item name="android:colorAccent">@color/ui_blue</item>
        <item name="android:colorControlActivated">@color/ui_purple</item>
        <item name="android:colorControlHighlight">#55E3FF00</item>
        <item name="android:textColorPrimary">@color/ui_ink</item>
        <item name="android:textColorSecondary">@color/ui_muted</item>
        <item name="android:textColor">@color/ui_ink</item>
        <item name="android:textColorHint">@color/ui_muted</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:buttonStyle">@style/TrailButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/TrailButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/TrailButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/TrailButton</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="TrailButton" parent="android:style/Widget.Material.Button">
        <item name="android:fontFamily">@string/ui_button_font</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/ui_button_size</item>
        <item name="android:textColor">@color/ui_button_text</item>
        <item name="android:backgroundTint">@color/ui_button</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
</resources>
